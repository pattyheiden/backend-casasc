generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADVERTISER
  BROKER
  MODERATOR
  ADMIN
}

enum AdvertiserType {
  broker
  owner
}

enum PropertyPriceType {
  sale
  rent
}

enum PropertyStatus {
  draft
  published
  paused
  archived
}

enum LeadType {
  view
  whatsapp_click
  share
  form_contact
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  passwordHash String?
  role         UserRole    @default(ADVERTISER)
  advertiser   Advertiser?
  favorites    Favorite[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Advertiser {
  id                    String      @id @default(uuid()) @db.Uuid
  userId                String?     @unique @db.Uuid
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  phone                 String
  type                  AdvertiserType
  avatar                String?
  creci                 String?
  isVerified            Boolean     @default(false)
  verificationStatus    String      @default("pending")
  verificationDocuments String[]    @default([])
  properties            Property[]
  leads                 Lead[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([type, isVerified])
}

model City {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  image         String
  neighborhoods Neighborhood[]
  properties    Property[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Neighborhood {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  slug       String
  cityId     String     @db.Uuid
  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([cityId, slug])
}

model Property {
  id                 String            @id @default(uuid()) @db.Uuid
  title              String
  slug               String
  price              Int
  priceType          PropertyPriceType
  cityId             String            @db.Uuid
  city               City              @relation(fields: [cityId], references: [id])
  neighborhoodId     String            @db.Uuid
  neighborhood       Neighborhood      @relation(fields: [neighborhoodId], references: [id])
  address            String?
  bedrooms           Int
  bathrooms          Int
  area               Int
  parkingSpaces      Int
  images             String[]          @default([])
  description        String
  features           String[]          @default([])
  advertiserId       String            @db.Uuid
  advertiser         Advertiser        @relation(fields: [advertiserId], references: [id])
  isPremium          Boolean           @default(false)
  status             PropertyStatus    @default(draft)
  publishedAt        DateTime?
  views              Int               @default(0)
  whatsappClicks     Int               @default(0)
  shares             Int               @default(0)
  leads              Lead[]
  favorites          Favorite[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([cityId, neighborhoodId, slug])
  @@index([status, priceType, isPremium, createdAt])
  @@index([cityId, neighborhoodId])
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Lead {
  id           String     @id @default(uuid()) @db.Uuid
  propertyId   String     @db.Uuid
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  advertiserId String     @db.Uuid
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  type         LeadType
  name         String?
  email        String?
  phone        String?
  message      String?
  metadata     Json?
  createdAt    DateTime   @default(now())

  @@index([propertyId, type, createdAt])
  @@index([advertiserId, createdAt])
}
